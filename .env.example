# =============================================================================
# MitFahr.io – Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an
# =============================================================================

# --- App ---
APP_PORT=22225
APP_BASE_URL=https://tankpreis-rechner.nas-timgreen.com

# --- Datenbank ---
POSTGRES_PASSWORD=<bitte-eintragen>

# --- Auth ---
# Mindestens 32 Zeichen, zufällig generiert
# Generieren: openssl rand -hex 32
JWT_SECRET=<bitte-eintragen>

# --- Registrierung ---
# false = Registrierung gesperrt (nur Einladungen)
REGISTRATION_ENABLED=true

# E-Mail-Verifizierung erzwingen (true/false)
EMAIL_VERIFICATION_REQUIRED=false

# --- SMTP (optional – für Passwort-Reset + E-Mail-Verifizierung) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = SSL (Port 465), false = STARTTLS (Port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mitfahr.io

# Dev-Only: Reset-Link direkt in API-Antwort zurückgeben (kein SMTP nötig)
# 0 = deaktiviert, 1 = aktiviert (NUR für Entwicklung!)
ALLOW_DEV_RESET_LINK=0

# Admin-Konto (Benutzer-Verwaltung + Passwort zurücksetzen ohne E-Mail)
ADMIN_EMAIL=nagraszust@gmail.com

# --- Schulden-Konfiguration ---
# Anzahl Tage bis eine offene Schuld als "überfällig" markiert wird
DEBT_OVERDUE_DAYS=14

# --- Automatische Kraftstoffpreise (Tankerkoenig) ---
# Kostenlosen API-Key holen: https://creativecommons.tankerkoenig.de/
TANKERKOENIG_API_KEY=

# Optional: Secret für externen Cron-Aufruf POST /api/internal/cron/fuel-prices
CRON_SECRET=
