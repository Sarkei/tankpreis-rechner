# =============================================================================
# MitFahr.io – Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an
# =============================================================================

# --- App ---
# Port, unter dem die App auf dem Host erreichbar ist
APP_PORT=22225

# --- Datenbank ---
POSTGRES_PASSWORD=bitte-eintragen

# --- Tankpreise (clever-tanken.de, kein API-Key nötig) ---
# PLZ für die Tankstellensuche (10-km-Umkreis, Durchschnitt der 5 günstigsten)
FUEL_PLZ=83278
# Cache-Dauer in Stunden
FUEL_PRICE_TTL_HOURS=6

# --- Fahrzeug ---
# Standardverbrauch in l/100 km für neue Fahrten (im UI jederzeit änderbar)
DEFAULT_CONSUMPTION=8
